APP_NAME=AutoAnalyst AI
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_SIZE_MB=25
MAX_DATASET_ROWS=100000
MAX_DATASET_COLUMNS=200

# AI / LLM Configuration (Phase 4.1)
# Add your Gemini API key below to enable generative AI explanations.
# If omitted or empty, AutoAnalyst AI runs safely in deterministic Statistical Fallback mode.
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-3.8-flash
AI_TIMEOUT_SECONDS=30
AI_CACHE_ENABLED=true
